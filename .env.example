# Example .env for Alpaca Trading Bot
APCA_API_KEY_ID=your_alpaca_api_key
APCA_API_SECRET_KEY=your_alpaca_api_secret
APCA_API_BASE_URL=https://paper-api.alpaca.markets
TRADE_SYMBOL=AAPL
TRADE_TIMEFRAME=5Min
TRADE_LOOKBACK=200
TRADE_POLL_INTERVAL=60

# Short selling: when true (the default), the bot also shorts overbought rips —
# the mirror of its long oversold-dip entry (mean-reversion only). Set to false
# to run long-only. Shorting requires a margin account and easy-to-borrow names
# (the scanner already filters for easy_to_borrow).
ENABLE_SHORTS=true

# Force-include watchlist: names that ALWAYS enter the universe, even if the
# liquidity scanner misses them. Use to try new tickers. Comma-separated.
TRADE_WATCHLIST=
# Force-exclude blocklist: names that NEVER trade, even if the scanner surfaces
# them. Use to dump chronic losers. Comma-separated. Wins over the watchlist.
TRADE_BLOCKLIST=

# Per-symbol allowlist gate (written by autotune_run.py). Unset = trade
# everything the scanner/watchlist returns. Set = only trade these names.
# An explicitly empty value means nothing qualified -> trade nothing.
TRADE_ALLOWLIST=
# Thresholds the autotuner uses to decide which symbols make the allowlist.
ALLOWLIST_MIN_PF=1.10
ALLOWLIST_MIN_SHARPE=0.0

# --- Strategy tuning (all read by the live bot; defaults shown) -------------
# Weighted ensemble score a candidate must clear to trade (routing floor +
# pre-adaptive threshold). Raise to be more selective.
MIN_TRADE_SCORE=0.36
# Bollinger entry zone: lb1/lb2 = sma -/+ band_std_* * std over band_length.
BAND_LENGTH=20
BAND_STD_1=1.0
BAND_STD_2=2.0
# Indicator lookbacks.
RI_LENGTH=20
RSI_LENGTH=14
ADX_LENGTH=14
TREND_EMA_LENGTH=50
# Long oversold gates (price must be <= lb1 AND oversold by RI or RSI).
RI_THRESHOLD=-0.5
RSI_MAX=48.0
ADX_MAX=40.0
# Hard safety blocks (long blow-off top): skip when ADX and RSI are both extreme.
ADX_HARD_MAX=50.0
RSI_HARD_MAX=70.0
# Short side (mirror of the long gates): overbought when RI >= or RSI >=.
RI_SHORT_THRESHOLD=0.5
RSI_MIN=52.0
# Reflected hard block: don't short a strongly-trending capitulation.
RSI_HARD_MIN=30.0
# Optional entry confirmations (all default off).
REQUIRE_RECLAIM_LB1=False
REQUIRE_BULLISH_CLOSE=False
REQUIRE_VOLUME_EXPANSION=False
VOLUME_LOOKBACK=20
VOLUME_MULTIPLIER_MIN=1.0
USE_VWAP_FILTER=False
MAX_VWAP_EXTENSION_PCT=0.012
USE_TREND_FILTER=False
# Liquidity / price floors.
MAX_SPREAD_BPS=40.0
MIN_DOLLAR_VOLUME=750000.0
MIN_PRICE=5.0
# Trend-fail sub-strategy.
TRENDFAIL_WINDOW=20
TRENDFAIL_THRESHOLD=0.005

# --- Risk / position sizing -------------------------------------------------
RISK_PER_TRADE_PCT=0.005
MAX_POSITION_VALUE_PCT=0.15
MIN_RR=1.5
# ATR-based stop/target distances per entry style.
STOP_ATR_MULTIPLE=1.20
TARGET_ATR_MULTIPLE=2.00
TREND_STOP_ATR_MULTIPLE=1.20
TREND_TARGET_ATR_MULTIPLE=3.00
TRENDFAIL_STOP_ATR_MULTIPLE=1.10
TRENDFAIL_TARGET_ATR_MULTIPLE=2.20
ATR_LENGTH=14
ATR_FLOOR_PCT=0.0035

# --- Performance / adaptive threshold ---------------------------------------
PERF_STATE_DIR=state/performance
PERF_ENABLE_ADAPTIVE_THRESHOLD=true
PERF_MIN_SAMPLES=20
PERF_MAX_THRESHOLD_ADJ=0.05
# Persist the fitted ML model so a daily restart doesn't cold-start it (the ML
# component is 25% of the blend and is in-memory only otherwise). Loaded at
# startup if present and fresher than ML_MODEL_MAX_AGE_HOURS; re-saved after each
# retrain. A stale/incompatible load self-heals (failed predict -> retrain).
PERSIST_ML_MODEL=true
ML_MODEL_MAX_AGE_HOURS=168

# --- Market-regime filter ---------------------------------------------------
# When the benchmark is below its trend EMA (risk-off), suppress NEW long
# entries — dip-buying every oversold name in a market-wide selloff is the
# losing trade. Shorts and existing positions are unaffected. Fail-open: a
# benchmark fetch error is treated as risk-on so trading never halts on a hiccup.
USE_MARKET_REGIME_FILTER=true
MARKET_REGIME_SYMBOL=SPY          # use QQQ for a tech-tilted universe
MARKET_REGIME_TIMEFRAME=1Day
MARKET_REGIME_EMA=50
# Opt-in: when risk-off, also relax the short trigger so the bot leans short
# into the downtrend (fades rips more eagerly) instead of only sitting in cash.
# The relaxed overbought thresholds below apply only while risk-off + this flag.
FAVOR_SHORTS_IN_RISK_OFF=false
RISK_OFF_RSI_MIN=45.0
RISK_OFF_RI_SHORT_THRESHOLD=0.25

# Sector-aware regime gate (opt-in, default off). Judges each long against ITS
# sector's proxy ETF (SMH/XLK/XLE/XLB/XLF/XLV) instead of only SPY, so a
# sector-specific selloff (e.g. semis dumping while SPY holds) suppresses that
# sector's longs. Reuses MARKET_REGIME_TIMEFRAME/EMA; ETFs are fetched hourly
# (the gate is a daily EMA). Unmapped names fall back to the SPY signal.
# Combine: "or" = suppress if sector OR SPY risk-off; "sector" = sector only.
USE_SECTOR_REGIME_FILTER=false
SECTOR_REGIME_COMBINE=or

# --- Entry execution --------------------------------------------------------
# Marketable-limit entries cap slippage: the entry leg is priced a few bps
# THROUGH the planned entry (above for a buy, below for a short) so it still
# crosses the spread and fills, instead of a plain market order. Set
# USE_LIMIT_ENTRY=false to revert to market entries. Note: if price runs past
# the offset before filling, the entry may not fill (bracket sits working until
# the EOD cancel) — that's the slippage/fill tradeoff.
USE_LIMIT_ENTRY=true
LIMIT_ENTRY_OFFSET_BPS=8
TRADE_TIF=day

# Order-path SDK (opt-in). Default false = the legacy alpaca_trade_api REST
# client (unchanged, proven path). Set true to route orders through the
# maintained alpaca-py TradingClient instead — paper-test before relying on it.
USE_ALPACA_PY=false

# --- Breakout exit (opt-in) -------------------------------------------------
# The fixed ATR target clips winners. An A/B (entry held constant) showed that
# exiting LONGs when price reaches the upper linear-regression channel ("sell
# the breakout") lifted signal-layer median PF 0.85 -> 1.00 and rescued the
# high-beta names the fixed target was capping (AMD/MU/ARM/CLF). A naive
# trailing stop did the OPPOSITE — so the exit must be structural, not a trail.
#
# Two ways to use this:
#  (b) cheap/static: just widen TARGET_ATR_MULTIPLE (e.g. 3.5) so winners run
#      further. No active management. Helps the movers, blunt on rangey names.
#  (a) the validated win: USE_CHANNEL_EXIT=true actively market-closes a long at
#      the upper channel, with the (wide) bracket target as the broker-side
#      backstop. Default OFF. Paper-test before going live.
USE_CHANNEL_EXIT=false
CHANNEL_EXIT_THRESHOLD=0.80   # exit when channel position >= this (1.0 = top band)
CHANNEL_LOOKBACK=80           # bars in the regression channel
CHANNEL_K=2.0                 # channel half-width in residual stdevs

# --- Churn / cooldowns ------------------------------------------------------
# After an entry, block ALL re-entry on the symbol for this many minutes.
SYMBOL_COOLDOWN_MINUTES=30
# After an entry, block re-entry in the OPPOSITE direction on the same symbol
# for this many minutes (whipsaw guard: stops the short->stop->long->stop churn
# seen live). Should be >= SYMBOL_COOLDOWN_MINUTES to matter. 0 = off.
DIRECTION_FLIP_COOLDOWN_MINUTES=60

# --- Networking -------------------------------------------------------------
# HTTP connection-pool size for the Alpaca REST session. The bot evaluates the
# whole universe concurrently, so the requests default of 10 overflows and logs
# "Connection pool is full". Size this at or above your universe count.
CONN_POOL_MAXSIZE=32
# Per-request HTTP timeout (seconds) for Alpaca market-data calls. alpaca-py
# sets none by default, so a hung connection would block a worker thread forever
# and freeze a poll cycle ("Read timed out, read timeout=None"). A stalled call
# now aborts after this many seconds and the symbol is skipped that cycle.
ALPACA_HTTP_TIMEOUT=15

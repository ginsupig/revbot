# Example .env for Alpaca Trading Bot
APCA_API_KEY_ID=your_alpaca_api_key
APCA_API_SECRET_KEY=your_alpaca_api_secret
APCA_API_BASE_URL=https://paper-api.alpaca.markets
TRADE_SYMBOL=AAPL
TRADE_TIMEFRAME=5Min
TRADE_LOOKBACK=200
TRADE_POLL_INTERVAL=60

# Per-symbol allowlist gate (written by autotune_run.py). Unset = trade
# everything the scanner/watchlist returns. Set = only trade these names.
# An explicitly empty value means nothing qualified -> trade nothing.
TRADE_ALLOWLIST=
# Thresholds the autotuner uses to decide which symbols make the allowlist.
ALLOWLIST_MIN_PF=1.10
ALLOWLIST_MIN_SHARPE=0.0

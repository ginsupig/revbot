<?xml version="1.0" encoding="UTF-8"?>
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>revbot supervisor — starts run_bot.ps1, which launches and restarts python main.py. Single-instance guarded; safe with multiple triggers.</Description>
    <URI>\revbot</URI>
  </RegistrationInfo>
  <Triggers>
    <!-- Fresh start every weekday at 08:25 local time (before US market open). -->
    <CalendarTrigger>
      <StartBoundary>2026-01-01T08:25:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByWeek>
        <DaysOfWeek>
          <Monday />
          <Tuesday />
          <Wednesday />
          <Thursday />
          <Friday />
        </DaysOfWeek>
        <WeeksInterval>1</WeeksInterval>
      </ScheduleByWeek>
    </CalendarTrigger>
    <!-- Also (re)start on logon, so a reboot during the day brings it back. -->
    <LogonTrigger>
      <Enabled>true</Enabled>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>true</RunOnlyIfNetworkAvailable>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <!-- Wake a sleeping machine for the 08:25 pre-open start. (Note: with the
         InteractiveToken principal it still only runs while you're logged on;
         use a Password/S4U principal to trade fully logged off.) -->
    <WakeToRun>true</WakeToRun>
    <!-- Backstop: force-stop ~7h after the 08:25 CT start (i.e. ~15:25 CT, just
         past the 15:00 close) in case the bot's own clean end-of-day exit ever
         fails. Normal days end well before this when main.py exits at the close. -->
    <ExecutionTimeLimit>PT7H</ExecutionTimeLimit>
    <Priority>7</Priority>
    <!-- Task Scheduler's own restart-on-failure, on top of the wrapper loop. -->
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>3</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>powershell.exe</Command>
      <Arguments>-ExecutionPolicy Bypass -NoProfile -WindowStyle Hidden -File "C:\revbot\run_bot.ps1"</Arguments>
      <WorkingDirectory>C:\revbot</WorkingDirectory>
    </Exec>
  </Actions>
</Task>

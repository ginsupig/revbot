# Example .env for Alpaca Trading Bot
APCA_API_KEY_ID=your_alpaca_api_key
APCA_API_SECRET_KEY=your_alpaca_api_secret
APCA_API_BASE_URL=https://paper-api.alpaca.markets
# Optional: comma-separated override of the leveraged tech universe (blank = use built-in default)
TRADE_SYMBOL=TQQQ,SOXL,TECL,NVDL,TSLL,AAPU,METU,GGLL,MSFU,AMZU
TRADE_TIMEFRAME=5Min
TRADE_LOOKBACK=200
TRADE_POLL_INTERVAL=60

# --- Entry-signal thresholds (now read by the live bot, not just backtests) ---
# These use the same names as autotune_run.py / walk-forward, so a tuned .env
# applies to live trading too. Values below are the dataclass defaults; leave
# them unset to keep default behavior. Stricter mean-reversion entries = larger
# BAND_STD_1 (require a deeper dip), lower RSI_MAX / more-negative RI_THRESHOLD.
BAND_LENGTH=20
BAND_STD_1=1.0
BAND_STD_2=2.0
RI_THRESHOLD=-0.5
RSI_MAX=48.0
ADX_MAX=40.0
MAX_VWAP_EXTENSION_PCT=0.012

# --- Entry execution (wide-spread leveraged ETFs) ---
# Marketable limit entries cap slippage on wide spreads. Buy limit is placed
# this many bps ABOVE the planned entry so it still crosses and fills.
USE_LIMIT_ENTRY=True
LIMIT_ENTRY_OFFSET_BPS=8
TRADE_TIF=day

# --- Leverage-aware risk (recommended for the 3x/2x ETF universe) ---
# These notional caps are NOT leverage-aware on their own: 15% notional in a 3x
# ETF is ~45% effective index exposure, and 95% invested in 2-3x ETFs is ~2-3x
# portfolio beta. The values below pull effective beta back toward ~1-1.5x.
# Per-trade sizing is ATR-based and already self-normalizes for volatility, so
# RISK_PER_TRADE_PCT is left at the default.
RISK_PER_TRADE_PCT=0.005
MAX_POSITION_VALUE_PCT=0.08
MAX_TOTAL_EXPOSURE_PCT=0.45
MAX_OPEN_POSITIONS=3

# --- Trading session schedule (America/Chicago, 24h HH:MM) ---
# SESSION_START: daily launch time. No new entries are opened before this.
#   Default 09:00 CT (skips the volatile first 30 min after the 08:30 CT open).
# SESSION_END:   daily close time. Positions are flattened starting
#   EOD_LIQUIDATION_MINUTES before this, and no new entries are opened after it.
#   Default 15:00 CT / 16:00 ET (the regular market close).
SESSION_START=09:00
SESSION_END=15:00

# --- End-of-day liquidation (avoid overnight gap risk on leveraged ETFs) ---
# Minutes before SESSION_END to start flattening all positions.
# Larger = more buffer to get filled before the close.
EOD_LIQUIDATION_MINUTES=10

# --- Self-exit at session close ---
# When True (default), the bot terminates its own process once it has flattened
# at session close AND confirmed the account is flat. This lets a daily launcher
# (e.g. Windows Task Scheduler triggering the task each morning) end cleanly
# instead of relying on a kill timer. Set False to keep the old behavior of
# idling in a loop until the process is killed externally.
EXIT_ON_SESSION_CLOSE=True
